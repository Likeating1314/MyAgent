OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
WORKSPACE_DIR=./workspace
SQLITE_PATH=./data/agent.sqlite3
ALLOW_COMMAND_EXECUTION=false
MAX_AGENT_STEPS=8
SESSION_RUN_LEASE_SECONDS=120
MAX_CONTEXT_CHARS=120000
MAX_TOOL_RESULT_CHARS=20000
MAX_COMMAND_OUTPUT_CHARS=20000
MAX_USER_MESSAGE_CHARS=20000
MAX_MESSAGE_CHARS=40000
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null
APPROVAL_TTL_SECONDS=900
# Only enable behind a loopback-only container port mapping.
# ALLOW_NON_LOOPBACK_TOKEN_BOOTSTRAP=true
API_AUTH_TOKEN=replace-with-at-least-32-random-characters
JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
JWT_ISSUER=http://127.0.0.1:8081
JWT_AUDIENCE=local-agent
JWKS_CACHE_SECONDS=300
BUSINESS_API_BASE_URL=http://127.0.0.1:8081
BUSINESS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BUSINESS_DATABASE_NAME=local_agent
BUSINESS_DATABASE_USER=local_agent
BUSINESS_DATABASE_PASSWORD=replace-with-a-strong-password
# PEM values are deployment secrets; do not commit real keys.
JWT_PRIVATE_KEY_PEM=file:/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PEM=file:/run/secrets/jwt-public.pem
# Use an independent random secret of at least 32 characters; never reuse JWT key material.
EMAIL_VERIFICATION_CODE_SECRET=replace-with-at-least-32-random-characters
EMAIL_VERIFICATION_TTL=PT10M
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT1M
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_FROM=
